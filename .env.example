# docker-compose settings (copy to .env). Backend settings live in backend/.env.
DOMAIN=event.myclinic.com.sa
# Optional extra hostnames (space separated) that should also serve the app, e.g. the old address.
ALT_DOMAIN=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
