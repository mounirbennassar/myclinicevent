APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/myclinic_events
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public address of the site; used in emailed links and QR codes.
# Production: https://event.myclinic.com.sa (the compose file sets it from DOMAIN).
PUBLIC_BASE_URL=http://localhost:3000
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false

# Bootstrap super admin (created on first start if no user has this email)
SUPERADMIN_EMAIL=admin@myclinic.local
SUPERADMIN_PASSWORD=change-me-please
SUPERADMIN_NAME=My Clinic Super Admin

# Email (optional). Resend is used when RESEND_API_KEY is set, otherwise SMTP when SMTP_HOST is set.
# With neither, emails are printed to the API log instead.
# The sender domain must be verified in Resend; onboarding@resend.dev only delivers to the account owner.
# Resend only sends: EMAIL_FROM doesn't need a mailbox, but EMAIL_REPLY_TO should be one someone reads.
EMAIL_FROM=My Clinic Educational <events@myclinic.com.sa>
EMAIL_REPLY_TO=events@myclinic.com.sa
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Validation / scanning
STRICT_NATIONAL_ID=true
SCAN_COOLDOWN_SECONDS=45
SCAN_WINDOW_MARGIN_HOURS=3
DEFAULT_TIMEZONE=Asia/Riyadh
